
page {
  
  --color-primary: #07c160;
  --color-primary-light: #e8f8ef;
  --color-danger: #e64340;
  --color-warning: #ff976a;

  
  --color-bg: #f5f5f5;
  --color-surface: #ffffff;
  --color-text: #333333;
  --color-text-secondary: #666666;
  --color-text-placeholder: #999999;
  --color-border: #eaeaea;

  
  --font-size-xs: 20rpx;
  --font-size-sm: 24rpx;
  --font-size-md: 28rpx;
  --font-size-lg: 32rpx;
  --font-size-xl: 36rpx;
  --font-size-xxl: 44rpx;

  
  --space-xs: 8rpx;
  --space-sm: 16rpx;
  --space-md: 24rpx;
  --space-lg: 32rpx;
  --space-xl: 48rpx;

  
  --radius-sm: 8rpx;
  --radius-md: 12rpx;
  --radius-lg: 16rpx;
  --radius-full: 999rpx;

  
  --shadow-card: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}
