.page-container { min-height: 100vh; background: #F7F6F3; padding-bottom: 120rpx; }
.tab-bar { display: flex; background: #fff; border-bottom: 2rpx solid #EAEAEA; }
.tab-item { flex: 1; text-align: center; padding: 24rpx 0; font-size: 28rpx; color: #5c6370; border-bottom: 4rpx solid transparent; }
.tab-item.active { color: #2563eb; border-bottom-color: #2563eb; font-weight: 700; }
.order-card { background: #fff; margin: 16rpx 32rpx; padding: 28rpx; border-radius: 16rpx; border: 2rpx solid #EAEAEA; display: flex; justify-content: space-between; align-items: center; }
.order-info { flex: 1; }
.order-name { font-size: 30rpx; font-weight: 600; color: #1a1a2e; }
.order-amount { font-size: 32rpx; font-weight: 700; color: #dc2626; margin-left: 16rpx; }
.order-meta { text-align: right; }
.order-date { display: block; font-size: 22rpx; color: #9ca3af; }
.order-status { font-size: 24rpx; color: #5c6370; }
.order-status.done { color: #16a34a; font-weight: 600; }
.empty { text-align: center; padding: 80rpx 0; color: #9ca3af; font-size: 28rpx; }

.empty-state { text-align: center; padding: 80rpx 48rpx; }
.empty-state .empty-title { display: block; font-size: 32rpx; color: #5c6370; margin-bottom: 12rpx; }
.empty-state .empty-desc { display: block; font-size: 26rpx; color: #9ca3af; margin-bottom: 32rpx; }
.empty-state .empty-cta { display: inline-block; background: #2563eb; color: #fff; padding: 16rpx 40rpx; border-radius: 999rpx; font-size: 28rpx; font-weight: 600; }

.contact-section { text-align: center; padding: 48rpx 32rpx; margin-top: 32rpx; }
.contact-text { font-size: 26rpx; color: #9ca3af; display: block; margin-bottom: 16rpx; }
.contact-btn { display: inline-block; background: #fff; color: #2563eb; border: 2rpx solid #2563eb; padding: 12rpx 40rpx; border-radius: 999rpx; font-size: 28rpx; font-weight: 600; line-height: normal; }
