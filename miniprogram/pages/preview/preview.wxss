
.container { padding: 32rpx; background: #f0f2f5; min-height: 100vh; }
.preview-canvas { width: 100%; height: 400rpx; background: #ffffff; border-radius: 16rpx; border: 2rpx solid #e5e7eb; display: flex; align-items: center; justify-content: center; }
.render-btn {
  margin-top: 32rpx;
  background: #2563eb;
  color: #ffffff;
  border-radius: 12rpx;
  font-size: 32rpx;
  font-weight: 600;
  height: 88rpx;
  line-height: 88rpx;
}
.hint { display: block; text-align: center; color: #16a34a; margin-top: 24rpx; font-size: 28rpx; font-weight: 600; }
