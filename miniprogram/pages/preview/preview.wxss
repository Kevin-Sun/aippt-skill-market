.preview-container { width: 100%; height: 100vh; background: #1a1a2e; display: flex; flex-direction: column; align-items: center; justify-content: center; position: relative; }

.preview-swiper { width: 100%; height: 70vh; }
.preview-slide { display: flex; align-items: center; justify-content: center; }
.preview-image { width: 100%; height: 100%; }

.preview-fallback { position: absolute; top: 0; left: 0; width: 100%; height: 70vh; display: flex; align-items: center; justify-content: center; }
.fallback-card { width: 560rpx; height: 320rpx; border-radius: 20rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; }
.fallback-text { color: #fff; font-size: 36rpx; font-weight: 700; }
.fallback-sub { color: rgba(255,255,255,0.7); font-size: 24rpx; margin-top: 12rpx; }

.preview-hud { position: absolute; bottom: 60rpx; left: 0; width: 100%; display: flex; justify-content: space-between; align-items: center; padding: 0 40rpx; box-sizing: border-box; }
.preview-page-indicator { color: #fff; font-size: 28rpx; opacity: 0.9; }
.preview-actions { display: flex; gap: 24rpx; }
.preview-action-btn { color: #fff; font-size: 28rpx; padding: 12rpx 32rpx; background: rgba(255,255,255,0.15); border-radius: 999rpx; }
