<!--pages/promotion-detail/promotion-detail.wxml-->
<view class="page-container" wx:if="{{activity}}">
  <image class="activity-banner" src="{{activity.banner}}" mode="aspectFill" />
  <view class="activity-header">
    <text class="activity-title">{{activity.title}}</text>
    <view class="countdown-box">
      <text class="countdown-label">倒计时</text>
      <text class="countdown-time">{{countdown}}</text>
    </view>
  </view>
  <view class="section">
    <text class="section-title">活动规则</text>
    <view class="rule-item" wx:for="{{activity.rules}}" wx:key="*this">
      <text class="rule-text">{{item}}</text>
    </view>
  </view>
  <view class="section">
    <text class="section-title">参与流程</text>
    <view class="step-item" wx:for="{{activity.steps}}" wx:key="step">
      <view class="step-num">{{item.step}}</view>
      <view class="step-content">
        <text class="step-title">{{item.title}}</text>
        <text class="step-desc">{{item.desc}}</text>
      </view>
    </view>
  </view>
  <view class="section" wx:if="{{activity.inviteRecords.length > 0}}">
    <text class="section-title">我的邀请记录</text>
    <view class="invite-item" wx:for="{{activity.inviteRecords}}" wx:key="*this">
      <text class="invite-name">{{item.name}}</text>
      <text class="invite-status">{{item.status}}</text>
    </view>
  </view>
  <view class="section" wx:if="{{activity.rewards.length > 0}}">
    <text class="section-title">奖励展示</text>
    <view class="reward-item" wx:for="{{activity.rewards}}" wx:key="*this">
      <text class="reward-name">{{item.name}}</text>
      <text class="reward-status">{{item.status}}</text>
    </view>
  </view>
  <view class="bottom-bar">
    <view class="cta-btn" bindtap="onInviteTap">立即邀请</view>
  </view>
</view>
