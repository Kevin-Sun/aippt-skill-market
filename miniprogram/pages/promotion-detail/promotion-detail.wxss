/* promotion-detail.wxss */
.page-container { padding-bottom: 140rpx; background: #f0f2f5; min-height: 100vh; }
.activity-banner { width: 100%; height: 360rpx; }
.activity-header { padding: 32rpx; background: #fff; }
.activity-title { display: block; font-size: 40rpx; font-weight: 700; color: #1a1a2e; margin-bottom: 16rpx; }
.countdown-box { display: flex; align-items: center; }
.countdown-label { font-size: 26rpx; color: #5c6370; margin-right: 12rpx; }
.countdown-time { font-size: 32rpx; font-weight: 700; color: #dc2626; }
.section { padding: 32rpx; background: #fff; margin-top: 16rpx; }
.section-title { font-size: 34rpx; font-weight: 700; color: #1a1a2e; display: block; margin-bottom: 24rpx; }
.rule-item { padding: 12rpx 0; }
.rule-text { font-size: 28rpx; color: #1a1a2e; line-height: 1.5; }
.step-item { display: flex; margin-bottom: 24rpx; }
.step-num { width: 48rpx; height: 48rpx; border-radius: 50%; background: #2563eb; color: #fff; display: flex; align-items: center; justify-content: center; font-size: 28rpx; font-weight: 700; flex-shrink: 0; }
.step-content { margin-left: 20rpx; }
.step-title { display: block; font-size: 30rpx; font-weight: 600; color: #1a1a2e; }
.step-desc { display: block; font-size: 26rpx; color: #5c6370; margin-top: 4rpx; }
.invite-item { display: flex; justify-content: space-between; padding: 16rpx 0; border-bottom: 2rpx solid #f0f2f5; }
.invite-name { font-size: 28rpx; color: #1a1a2e; }
.invite-status { font-size: 26rpx; color: #5c6370; }
.reward-item { display: flex; justify-content: space-between; padding: 16rpx 0; }
.reward-name { font-size: 28rpx; font-weight: 600; color: #1a1a2e; }
.reward-status { font-size: 26rpx; color: #16a34a; }
.bottom-bar { position: fixed; bottom: 0; left: 0; right: 0; padding: 20rpx 32rpx; background: #fff; border-top: 2rpx solid #e5e7eb; }
.cta-btn { width: 100%; height: 96rpx; display: flex; align-items: center; justify-content: center; background: #2563eb; border-radius: 12rpx; font-size: 34rpx; font-weight: 700; color: #fff; }
