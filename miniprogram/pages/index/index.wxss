/* index.wxss · V3.1 对齐两列 + 色彩碰撞 + 潮流感（taste-skill redesign-skill 规则） */
.page-container { min-height: 100vh; background: #F7F6F3; padding-bottom: 120rpx; }

/* 导航栏：极简 + logo serif */
.nav-bar { display: flex; justify-content: space-between; align-items: center; padding: 24rpx 48rpx; }
.nav-logo { font-family: "Noto Serif SC", Georgia, serif; font-size: 40rpx; font-weight: 700; color: #1a1a2e; letter-spacing: -1px; }
.nav-login-btn { background: #2563eb; color: #ffffff; padding: 12rpx 32rpx; border-radius: 999rpx; font-size: 26rpx; font-weight: 600; }
.nav-user { font-size: 26rpx; color: #5c6370; padding: 8rpx 16rpx; }

/* Hero 区：serif 大字 + muted pastel 微光 */
.hero-section { padding: 48rpx 48rpx 32rpx; position: relative; }
.hero-title { display: block; font-family: "Noto Serif SC", Georgia, serif; font-size: 56rpx; font-weight: 700; color: #1a1a2e; letter-spacing: -2px; line-height: 1.1; margin-bottom: 20rpx; }
.hero-subtitle { display: block; font-size: 30rpx; color: #5c6370; line-height: 1.5; }

/* 搜索框：双 bezel pill */
.search-bar { display: flex; align-items: center; margin: 24rpx 48rpx; background: #FFFFFF; border: 2rpx solid #EAEAEA; border-radius: 999rpx; padding: 4rpx; box-shadow: 0 2rpx 8rpx rgba(37,99,235,0.06); }
.search-input { flex: 1; padding: 20rpx 28rpx; font-size: 30rpx; color: #1a1a2e; background: transparent; }
.search-submit-btn { width: 72rpx; height: 72rpx; border-radius: 50%; background: #2563eb; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.search-icon-img { width: 36rpx; height: 36rpx; }

/* 场景筛选：胶囊标签 */
.scene-bar { white-space: nowrap; padding: 16rpx 48rpx; margin-bottom: 16rpx; }
.scene-tag { display: inline-block; padding: 12rpx 28rpx; margin-right: 16rpx; border-radius: 999rpx; font-size: 26rpx; font-weight: 500; color: #5c6370; background: #FFFFFF; border: 2rpx solid #EAEAEA; }
.scene-tag.active { background: #2563eb; color: #ffffff; border-color: #2563eb; }

/* 营销 banner：色彩碰撞（蓝色免费 + 红色特惠） */
.sale-banner { margin: 0 48rpx 24rpx; background: #dc2626; border-radius: 16rpx; padding: 32rpx; display: flex; justify-content: space-between; align-items: center; box-shadow: 0 4rpx 16rpx rgba(220,38,38,0.2); }
.sale-banner-text { color: #ffffff; }
.sale-banner-title { font-size: 32rpx; font-weight: 700; display: block; margin-bottom: 8rpx; }
.sale-banner-desc { font-size: 26rpx; opacity: 0.9; }
.sale-banner-cta { background: #ffffff; color: #dc2626; padding: 12rpx 32rpx; border-radius: 999rpx; font-size: 26rpx; font-weight: 700; flex-shrink: 0; }

.free-banner { margin: 0 48rpx 24rpx; background: #2563eb; border-radius: 16rpx; padding: 32rpx; display: flex; justify-content: space-between; align-items: center; box-shadow: 0 4rpx 16rpx rgba(37,99,235,0.15); }
.free-banner-text { color: #ffffff; }
.free-banner-title { font-size: 32rpx; font-weight: 700; display: block; margin-bottom: 8rpx; }
.free-banner-desc { font-size: 26rpx; opacity: 0.9; }
.free-banner-cta { background: #ffffff; color: #2563eb; padding: 12rpx 32rpx; border-radius: 999rpx; font-size: 26rpx; font-weight: 700; flex-shrink: 0; }

/* skill 列表：对齐两列 */
.skill-list { padding: 0 48rpx; display: flex; flex-wrap: wrap; justify-content: space-between; }

/* 双 bezel 卡片：外壳 + 内核（统一 48% 宽度对齐） */
.skill-card {
  width: 48%;
  background: #F7F6F3;
  border: 2rpx solid #EAEAEA;
  border-radius: 20rpx;
  padding: 4rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.skill-card-inner {
  background: #FFFFFF;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 1rpx 3rpx rgba(0,0,0,0.04), inset 0 1rpx 1rpx rgba(255,255,255,0.8);
}

/* 卡片头：渐变色背景（每个 skill 不同 gradient → 色彩碰撞 + 潮流感） */
.skill-card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
  min-height: 72rpx;
}
.skill-style-tag { color: #ffffff; font-size: 24rpx; font-weight: 700; letter-spacing: 1rpx; text-shadow: 0 1rpx 2rpx rgba(0,0,0,0.15); }
.skill-recommend {
  background: rgba(255,255,255,0.25);
  color: #ffffff;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  font-weight: 600;
  backdrop-filter: blur(4rpx);
}

/* 卡片体 */
.skill-card-body { padding: 24rpx; }
.skill-name { display: block; font-size: 28rpx; font-weight: 700; color: #1a1a2e; line-height: 1.3; margin-bottom: 8rpx; letter-spacing: -0.5rpx; }
.skill-desc { display: block; font-size: 24rpx; color: #5c6370; line-height: 1.5; margin-bottom: 16rpx; overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.skill-meta { display: flex; align-items: center; flex-wrap: wrap; }
.skill-meta > text + text { margin-left: 12rpx; }
.skill-scene { font-size: 22rpx; color: #2563eb; background: #dbeafe; padding: 4rpx 12rpx; border-radius: 999rpx; font-weight: 600; }
.skill-lang { font-size: 22rpx; color: #5c6370; background: #F7F6F3; padding: 4rpx 12rpx; border-radius: 999rpx; }
.skill-price { font-size: 28rpx; font-weight: 800; color: #dc2626; margin-left: auto; }
