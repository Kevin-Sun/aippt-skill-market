/* index.wxss · 清新 UI + 高对比度 + 无复杂动效 */

.page-container {
  min-height: 100vh;
  background: #f0f2f5;
  padding-bottom: 120rpx;
}

/* 导航栏 */
.nav-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  background: #ffffff;
  border-bottom: 2rpx solid #e5e7eb;
}
.nav-logo {
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1a2e;
  letter-spacing: -0.5px;
}
.nav-login-btn {
  background: #2563eb;
  color: #ffffff;
  padding: 12rpx 32rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  font-weight: 600;
}
.nav-user {
  font-size: 26rpx;
  color: #5c6370;
  padding: 8rpx 16rpx;
  background: #f0f2f5;
  border-radius: 8rpx;
}

/* 标题区 */
.hero-section {
  padding: 48rpx 32rpx 32rpx;
  background: #ffffff;
}
.hero-title {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: #1a1a2e;
  letter-spacing: -1px;
  margin-bottom: 16rpx;
}
.hero-subtitle {
  display: block;
  font-size: 30rpx;
  color: #5c6370;
  line-height: 1.4;
}

/* 搜索框 */
.search-bar {
  display: flex;
  align-items: center;
  margin: 24rpx 32rpx;
  background: #ffffff;
  border: 2rpx solid #e5e7eb;
  border-radius: 12rpx;
  overflow: hidden;
}
.search-input {
  flex: 1;
  padding: 20rpx 24rpx;
  font-size: 30rpx;
  color: #1a1a2e;
}
.search-submit-btn {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #2563eb;
}
.search-icon {
  font-size: 32rpx;
}

/* 场景筛选 */
.scene-bar {
  white-space: nowrap;
  padding: 16rpx 32rpx;
  background: #ffffff;
  border-bottom: 2rpx solid #e5e7eb;
}
.scene-tag {
  display: inline-block;
  padding: 12rpx 28rpx;
  margin-right: 16rpx;
  border-radius: 24rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: #5c6370;
  background: #f0f2f5;
  border: 2rpx solid transparent;
}
.scene-tag.active {
  background: #2563eb;
  color: #ffffff;
  border-color: #1d4ed8;
}

/* skill 列表 */
.skill-list {
  padding: 24rpx 32rpx;
}
.skill-card {
  background: #ffffff;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.08);
  border: 2rpx solid #e5e7eb;
}
.skill-card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 28rpx;
}
.skill-style-tag {
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
}
.skill-recommend {
  background: rgba(255,255,255,0.25);
  color: #ffffff;
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  font-weight: 600;
}
.skill-card-body {
  padding: 28rpx;
}
.skill-name {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a2e;
  line-height: 1.3;
  margin-bottom: 12rpx;
}
.skill-desc {
  display: block;
  font-size: 26rpx;
  color: #5c6370;
  line-height: 1.5;
  margin-bottom: 20rpx;
}
.skill-meta {
  display: flex;
  align-items: center;
}
.skill-meta > text + text {
  margin-left: 16rpx;
}
.skill-scene {
  font-size: 24rpx;
  color: #2563eb;
  background: #dbeafe;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-weight: 600;
}
.skill-lang {
  font-size: 24rpx;
  color: #5c6370;
  background: #f0f2f5;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}
.skill-price {
  font-size: 32rpx;
  font-weight: 700;
  color: #dc2626;
  margin-left: auto;
}
