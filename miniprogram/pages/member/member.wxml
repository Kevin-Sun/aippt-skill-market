<!--pages/member/member.wxml · 会员页（SKU对比表）-->
<view class="page-container">
  <view class="header">
    <text class="header-title">会员中心</text>
    <text class="header-subtitle">选择最适合你的方案</text>
  </view>

  <view class="tier-list">
    <view class="tier-card {{tier.recommended ? 'recommended' : ''}}" wx:for="{{tiers}}" wx:key="id" data-id="{{item.id}}" bindtap="onSubscribeTap">
      <view class="tier-badge" wx:if="{{item.badge}}">{{item.badge}}</view>
      <text class="tier-name">{{item.name}}</text>
      <view class="tier-price-row">
        <text class="tier-price" wx:if="{{item.price > 0}}">¥{{item.price}}</text>
        <text class="tier-price" wx:else>免费</text>
        <text class="tier-period" wx:if="{{item.period}}">/{{item.period}}</text>
      </view>
      <view class="tier-features">
        <text class="feature-item" wx:for="{{item.features}}" wx:for-item="f" wx:key="*this">✓ {{f}}</text>
      </view>
      <view class="tier-cta">开通</view>
    </view>
  </view>

  <view class="compare-table">
    <text class="table-title">权益对比</text>
    <view class="table-row table-header">
      <text class="table-cell">权益</text>
      <text class="table-cell">免费</text>
      <text class="table-cell">2.9</text>
      <text class="table-cell">9.9</text>
      <text class="table-cell highlight">19.9/月</text>
      <text class="table-cell">99.9/年</text>
    </view>
    <view class="table-row">
      <text class="table-cell">浏览</text>
      <text class="table-cell">✓</text><text class="table-cell">✓</text><text class="table-cell">✓</text><text class="table-cell highlight">✓</text><text class="table-cell">✓</text>
    </view>
    <view class="table-row">
      <text class="table-cell">单skill</text>
      <text class="table-cell">-</text><text class="table-cell">1个</text><text class="table-cell">-</text><text class="table-cell highlight">免费</text><text class="table-cell">免费</text>
    </view>
    <view class="table-row">
      <text class="table-cell">一类</text>
      <text class="table-cell">✗</text><text class="table-cell">✗</text><text class="table-cell">n个</text><text class="table-cell highlight">✓</text><text class="table-cell">✓</text>
    </view>
    <view class="table-row">
      <text class="table-cell">全库</text>
      <text class="table-cell">✗</text><text class="table-cell">✗</text><text class="table-cell">✗</text><text class="table-cell highlight">✓</text><text class="table-cell">✓</text>
    </view>
    <view class="table-row">
      <text class="table-cell">定制</text>
      <text class="table-cell">✗</text><text class="table-cell">✗</text><text class="table-cell">✗</text><text class="table-cell highlight">✗</text><text class="table-cell">✓</text>
    </view>
    <view class="table-row">
      <text class="table-cell">社群</text>
      <text class="table-cell">✗</text><text class="table-cell">✗</text><text class="table-cell">✗</text><text class="table-cell highlight">✗</text><text class="table-cell">✓</text>
    </view>
  </view>

  <view class="community-section" bindtap="onCommunityTap">
    <text class="community-title">知识星球社群</text>
    <text class="community-desc">299 年费 · 每日更新 · 加入社群 →</text>
  </view>
</view>
