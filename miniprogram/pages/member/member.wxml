<!--pages/member/member.wxml · 会员页（v1.6.0 无社群版）-->
<view class="page-container">
  <view class="header">
    <text class="header-title">会员中心</text>
    <text class="header-subtitle">选择最适合你的方案</text>
  </view>

  <view class="member-status" wx:if="{{isMember}}">
    <text class="status-text">会员已开通 · 全库 skill 已解锁</text>
  </view>

  <view class="tier-list">
    <view class="tier-card {{tier.recommended ? 'recommended' : ''}}" wx:for="{{tiers}}" wx:key="id" data-id="{{item.id}}" bindtap="onSubscribeTap">
      <view class="tier-badge" wx:if="{{item.badge}}">{{item.badge}}</view>
      <text class="tier-name">{{item.name}}</text>
      <view class="tier-price-row">
        <text class="tier-price" wx:if="{{item.price > 0}}">¥{{item.price}}</text>
        <text class="tier-price" wx:else>免费</text>
        <text class="tier-period" wx:if="{{item.period}}">/{{item.period}}</text>
      </view>
      <view class="tier-features">
        <text class="feature-item" wx:for="{{item.features}}" wx:for-item="f" wx:key="*this">✓ {{f}}</text>
      </view>
      <view class="tier-cta {{item.price > 0 ? '' : 'tier-cta-free'}}">{{item.price > 0 ? (isMember ? '续费' : '开通') : '当前可用'}}</view>    </view>
  </view>

  <view class="compare-table">
    <text class="table-title">权益对比</text>
    <view class="table-row table-header">
      <text class="table-cell">权益</text>
      <text class="table-cell">免费</text>
      <text class="table-cell">19/月</text>
      <text class="table-cell">99/年</text>
    </view>
    <view class="table-row">
      <text class="table-cell">浏览</text>
      <text class="table-cell">✓</text><text class="table-cell">✓</text><text class="table-cell">✓</text>
    </view>
    <view class="table-row">
      <text class="table-cell">全库 skill</text>
      <text class="table-cell">-</text><text class="table-cell">✓</text><text class="table-cell">✓</text>
    </view>
    <view class="table-row">
      <text class="table-cell">预览+导出</text>
      <text class="table-cell">-</text><text class="table-cell">✓</text><text class="table-cell">✓</text>
    </view>
    <view class="table-row">
      <text class="table-cell">定制调优</text>
      <text class="table-cell">-</text><text class="table-cell">-</text><text class="table-cell">✓</text>
    </view>
  </view>
</view>
