/* search.wxss */
.page-container { min-height: 100vh; background: #F7F6F3; padding-bottom: 120rpx; }
.search-bar { display: flex; align-items: center; padding: 24rpx 32rpx; background: #fff; border-bottom: 2rpx solid #EAEAEA; }
.search-input { flex: 1; height: 72rpx; background: #F7F6F3; border-radius: 999rpx; padding: 0 28rpx; font-size: 28rpx; }
.search-btn { background: #2563eb; color: #fff; padding: 16rpx 32rpx; border-radius: 999rpx; font-size: 26rpx; font-weight: 600; margin-left: 16rpx; }
.filter-bar { display: flex; justify-content: space-between; align-items: center; padding: 16rpx 32rpx; background: #fff; border-bottom: 2rpx solid #EAEAEA; }
.result-count { font-size: 26rpx; color: #5c6370; }
.filter-actions { display: flex; }
.sort-btn { font-size: 26rpx; color: #2563eb; font-weight: 600; }
.filter-panel { background: #fff; padding: 24rpx 32rpx; border-bottom: 2rpx solid #EAEAEA; }
.filter-row { margin-bottom: 20rpx; }
.filter-label { font-size: 24rpx; color: #9ca3af; display: block; margin-bottom: 12rpx; font-weight: 600; }
.filter-tags { display: flex; flex-wrap: wrap; }
.filter-tag { font-size: 24rpx; color: #5c6370; background: #F7F6F3; border: 2rpx solid #EAEAEA; padding: 8rpx 20rpx; border-radius: 999rpx; margin-right: 12rpx; margin-bottom: 8rpx; }
.filter-tag.active { background: #2563eb; color: #fff; border-color: #2563eb; }
.reset-btn { text-align: center; font-size: 26rpx; color: #dc2626; padding: 16rpx 0; margin-top: 16rpx; border-top: 2rpx solid #f0f2f5; }
.empty-state { text-align: center; padding: 80rpx 32rpx; }
.empty-title { display: block; font-size: 32rpx; color: #1a1a2e; margin-bottom: 12rpx; }
.empty-desc { display: block; font-size: 26rpx; color: #9ca3af; margin-bottom: 40rpx; }
.recommended-section { text-align: left; }
.recommended-title { display: block; font-size: 28rpx; color: #1a1a2e; margin-bottom: 16rpx; font-weight: 600; }
.recommended-item { display: flex; justify-content: space-between; align-items: center; padding: 20rpx 0; border-top: 2rpx solid #f0f2f5; }
.recommended-name { font-size: 28rpx; color: #1a1a2e; }
.recommended-price { font-size: 28rpx; font-weight: 700; color: #dc2626; }
.skill-list { padding: 16rpx 32rpx; }
.skill-item { display: flex; background: #fff; border-radius: 16rpx; margin-bottom: 16rpx; overflow: hidden; border: 2rpx solid #EAEAEA; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04); }
.skill-item-image { width: 120rpx; height: 120rpx; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.skill-item-style { color: #fff; font-size: 20rpx; font-weight: 700; text-align: center; }
.skill-item-body { flex: 1; padding: 16rpx 20rpx; }
.skill-item-name { display: block; font-size: 28rpx; font-weight: 600; color: #1a1a2e; line-height: 1.3; margin-bottom: 4rpx; }
.skill-item-desc { display: block; font-size: 22rpx; color: #5c6370; line-height: 1.4; margin-bottom: 8rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.skill-item-tags { display: flex; flex-wrap: wrap; margin-bottom: 8rpx; }
.tag-scene { font-size: 20rpx; color: #2563eb; background: #dbeafe; padding: 2rpx 10rpx; border-radius: 999rpx; margin-right: 8rpx; font-weight: 600; }
.tag-lang { font-size: 20rpx; color: #5c6370; background: #F7F6F3; padding: 2rpx 10rpx; border-radius: 999rpx; margin-right: 8rpx; }
.tag-agent { font-size: 20rpx; color: #7c3aed; background: #ede9fe; padding: 2rpx 10rpx; border-radius: 999rpx; }
.skill-item-footer { display: flex; justify-content: space-between; align-items: center; }
.skill-item-rating { font-size: 22rpx; color: #f59e0b; }
.skill-item-price { font-size: 28rpx; font-weight: 800; }
.skill-item-price.paid { color: #dc2626; }
.skill-item-price.free { color: #16a34a; }
.loading-more { text-align: center; padding: 32rpx 0; color: #9ca3af; font-size: 26rpx; }
.no-more { text-align: center; padding: 32rpx 0; color: #9ca3af; font-size: 26rpx; }
.member-guide-card { margin: 24rpx 32rpx; background: linear-gradient(135deg, #2563eb 0%, #7c3aed 100%); border-radius: 16rpx; padding: 24rpx 28rpx; display: flex; justify-content: space-between; align-items: center; box-shadow: 0 4rpx 16rpx rgba(37,99,235,0.15); }
.member-guide-left { flex: 1; }
.member-guide-title { display: block; font-size: 28rpx; font-weight: 700; color: #fff; margin-bottom: 4rpx; }
.member-guide-desc { display: block; font-size: 22rpx; color: rgba(255,255,255,0.85); }
.member-guide-action { background: rgba(255,255,255,0.25); color: #fff; padding: 12rpx 28rpx; border-radius: 999rpx; font-size: 26rpx; font-weight: 700; }
