.container { padding: 32rpx; background: #f9fafb; min-height: 100vh; }

.original-header { display: flex; flex-direction: column; align-items: flex-start; margin-bottom: 32rpx; }
.platform-badge { font-size: 22rpx; color: #fff; background: #6366f1; padding: 6rpx 20rpx; border-radius: 999rpx; margin-bottom: 16rpx; }
.original-title { font-size: 36rpx; font-weight: 700; color: #1a1a2e; line-height: 1.4; }
.original-author { font-size: 26rpx; color: #6b7280; margin-top: 8rpx; }

.original-cover { width: 100%; border-radius: 16rpx; overflow: hidden; margin-bottom: 24rpx; }
.cover-image { width: 100%; height: 420rpx; background: #fff; }
.original-cover-fallback { width: 100%; height: 200rpx; display: flex; align-items: center; justify-content: center; background: #f3f4f6; border-radius: 16rpx; margin-bottom: 24rpx; }
.fallback-text { color: #9ca3af; font-size: 26rpx; }

.original-info { display: flex; gap: 24rpx; margin-bottom: 24rpx; }
.info-item { font-size: 24rpx; color: #4b5563; background: #e5e7eb; padding: 6rpx 16rpx; border-radius: 999rpx; }

.original-desc { margin-bottom: 32rpx; }
.desc-text { font-size: 28rpx; color: #374151; line-height: 1.6; }

.original-actions { display: flex; gap: 20rpx; margin-bottom: 20rpx; }
.action-btn { flex: 1; height: 80rpx; display: flex; align-items: center; justify-content: center; background: #2563eb; border-radius: 12rpx; }
.action-btn text { color: #fff; font-size: 28rpx; font-weight: 600; }
.action-btn-secondary { flex: 1; height: 80rpx; display: flex; align-items: center; justify-content: center; background: #f3f4f6; border-radius: 12rpx; }
.action-btn-secondary text { color: #374151; font-size: 28rpx; }

.original-hint { text-align: center; }
.original-hint text { font-size: 22rpx; color: #9ca3af; }
