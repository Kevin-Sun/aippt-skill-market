/* mine.wxss · F4: VIP金色徽章 */
.page-container { min-height: 100vh; background: #F7F6F3; padding-bottom: 120rpx; }
.user-card { background: linear-gradient(135deg, #2563eb 0%, #7c3aed 100%); padding: 48rpx 48rpx 40rpx; border-radius: 0 0 32rpx 32rpx; box-shadow: 0 8rpx 24rpx rgba(37,99,235,0.2); }
.user-card.vip-card { background: linear-gradient(135deg, #f59e0b 0%, #fbbf24 50%, #f59e0b 100%); box-shadow: 0 8rpx 24rpx rgba(245,158,11,0.3); }
.user-row { display: flex; align-items: center; }
.user-avatar { width: 120rpx; height: 120rpx; border-radius: 50%; background: rgba(255,255,255,0.2); border: 4rpx solid rgba(255,255,255,0.4); display: flex; align-items: center; justify-content: center; font-size: 48rpx; color: #ffffff; font-weight: 700; flex-shrink: 0; }
.user-avatar.vip-avatar { background: rgba(255,255,255,0.3); border: 4rpx solid rgba(255,255,255,0.6); }
.user-info { margin-left: 24rpx; flex: 1; }
.user-name-row { display: flex; align-items: center; }
.user-name { font-size: 36rpx; font-weight: 700; color: #ffffff; margin-bottom: 8rpx; }
.vip-badge { display: flex; align-items: center; background: rgba(255,255,255,0.25); border: 2rpx solid rgba(255,255,255,0.4); padding: 4rpx 12rpx; border-radius: 999rpx; margin-left: 16rpx; }
.vip-icon { width: 28rpx; height: 28rpx; margin-right: 4rpx; }
.vip-text { font-size: 22rpx; color: #ffffff; font-weight: 700; letter-spacing: 1rpx; }
.user-tag { display: inline-block; font-size: 22rpx; color: #ffffff; background: rgba(255,255,255,0.25); padding: 4rpx 16rpx; border-radius: 999rpx; font-weight: 600; }
.stats-row { display: flex; margin: 24rpx 48rpx 0; background: #FFFFFF; border-radius: 20rpx; border: 2rpx solid #EAEAEA; overflow: hidden; box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.06); }
.stat-item { flex: 1; text-align: center; padding: 32rpx 0; border-right: 2rpx solid #EAEAEA; }
.stat-item:last-child { border-right: none; }
.stat-num { display: block; font-size: 48rpx; font-weight: 800; color: #2563eb; font-variant-numeric: tabular-nums; }
.stat-label { display: block; font-size: 22rpx; color: #5c6370; margin-top: 8rpx; }
.menu-group { margin: 24rpx 48rpx 0; background: #FFFFFF; border-radius: 20rpx; border: 2rpx solid #EAEAEA; overflow: hidden; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04); }
.menu-group-title { font-size: 24rpx; color: #9ca3af; padding: 24rpx 32rpx 12rpx; font-weight: 600; text-transform: uppercase; letter-spacing: 2rpx; }
.menu-item { display: flex; align-items: center; padding: 28rpx 32rpx; border-top: 2rpx solid #f0f2f5; position: relative; }
.menu-item:first-of-type { border-top: none; }
.menu-icon-img { width: 40rpx; height: 40rpx; margin-right: 20rpx; flex-shrink: 0; }
.menu-text { flex: 1; font-size: 30rpx; color: #1a1a2e; font-weight: 500; }
.menu-arrow-img { width: 28rpx; height: 28rpx; flex-shrink: 0; }
.menu-badge { font-size: 22rpx; color: #dc2626; background: #fde8e8; padding: 4rpx 12rpx; border-radius: 999rpx; margin-right: 12rpx; font-weight: 700; }
.vip-badge-tag { color: #16a34a; background: #dcfce7; }

.member-card {
  margin: 24rpx 48rpx 0;
  background: linear-gradient(135deg, #2563eb 0%, #7c3aed 100%);
  border-radius: 20rpx;
  padding: 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(37,99,235,0.15);
}
.member-card.member-active {
  background: linear-gradient(135deg, #f59e0b 0%, #fbbf24 100%);
  box-shadow: 0 4rpx 16rpx rgba(245,158,11,0.2);
}
.member-card-left { display: flex; align-items: center; flex: 1; }
.member-card-icon { width: 56rpx; height: 56rpx; margin-right: 20rpx; }
.member-card-info { flex: 1; }
.member-card-title { display: block; font-size: 30rpx; font-weight: 700; color: #ffffff; margin-bottom: 4rpx; }
.member-card-desc { display: block; font-size: 24rpx; color: rgba(255,255,255,0.85); }
.member-card-right { display: flex; align-items: center; }
.member-card-action { font-size: 26rpx; font-weight: 700; color: #ffffff; background: rgba(255,255,255,0.25); padding: 8rpx 24rpx; border-radius: 999rpx; margin-right: 12rpx; }
