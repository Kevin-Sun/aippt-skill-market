/* mine.wxss · V2 */
.container { background: #f0f2f5; min-height: 100vh; }
.user-section { display: flex; align-items: center; padding: 48rpx 32rpx; background: #fff; border-bottom: 2rpx solid #e5e7eb; }
.avatar { width: 96rpx; height: 96rpx; border-radius: 50%; background: #2563eb; color: #fff; display: flex; align-items: center; justify-content: center; font-size: 40rpx; font-weight: 700; }
.user-info { margin-left: 24rpx; }
.nick { font-size: 34rpx; font-weight: 600; color: #1a1a2e; display: block; }
.level { font-size: 26rpx; color: #5c6370; display: block; margin-top: 8rpx; }
.menu-section { margin-top: 16rpx; background: #fff; }
.menu-item { display: flex; align-items: center; padding: 32rpx; border-bottom: 2rpx solid #f0f2f5; }
.menu-text { flex: 1; font-size: 32rpx; color: #1a1a2e; }
.menu-badge { font-size: 24rpx; color: #fff; background: #dc2626; padding: 4rpx 12rpx; border-radius: 8rpx; margin-right: 16rpx; }
.menu-arrow { font-size: 36rpx; color: #9ca3af; }
