<!--pages/mine/mine.wxml · V2 我的页-->
<view class="container">
  <view class="user-section">
    <view class="avatar" wx:if="{{isLoggedIn}}">{{userInfo.nickName[0] || 'U'}}</view>
    <view class="avatar" wx:else>?</view>
    <view class="user-info">
      <text class="nick" wx:if="{{isLoggedIn}}">{{userInfo.nickName || '用户'}}</text>
      <text class="nick" wx:else bindtap="onLoginTap">点击登录</text>
      <text class="level">会员：{{memberLevel === 'free' ? '免费用户' : memberLevel}}</text>
    </view>
  </view>
  <view class="menu-section">
    <view class="menu-item" bindtap="onMemberTap">
      <text class="menu-text">会员中心</text>
      <text class="menu-arrow">→</text>
    </view>
    <view class="menu-item" bindtap="onOrdersTap">
      <text class="menu-text">已购/收藏/订单</text>
      <text class="menu-badge">{{purchasedCount + favoriteCount}}</text>
      <text class="menu-arrow">→</text>
    </view>
    <view class="menu-item" bindtap="onCommunityTap">
      <text class="menu-text">知识星球社群</text>
      <text class="menu-arrow">→</text>
    </view>
    <view class="menu-item" bindtap="onContactTap">
      <text class="menu-text">联系客服</text>
      <text class="menu-arrow">→</text>
    </view>
  </view>
</view>
