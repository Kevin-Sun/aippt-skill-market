<!--pages/mine/mine.wxml · P2: 会员权益一级入口外露-->
<view class="page-container">
  <view class="user-card {{isMember ? 'vip-card' : ''}}">
    <view class="user-row">
      <view class="user-avatar {{isMember ? 'vip-avatar' : ''}}">{{isLoggedIn ? userName.substring(0,1) : '?'}}</view>
      <view class="user-info">
        <view class="user-name-row">
          <text class="user-name">{{isLoggedIn ? userName : '未登录'}}</text>
          <view class="vip-badge" wx:if="{{isMember}}">
            <image class="vip-icon" src="/images/icons/crown.png" mode="aspectFit" />
            <text class="vip-text">VIP</text>
          </view>
        </view>
        <text class="user-tag" wx:if="{{isLoggedIn && isMember}}">尊贵会员</text>
        <text class="user-tag" wx:elif="{{isLoggedIn}}">普通用户</text>
        <text class="user-tag" wx:else>点击登录</text>
      </view>
    </view>
  </view>

  <!-- P2-1: 会员权益一级入口卡片（直接外露，不点一次） -->
  <view class="member-card {{isMember ? 'member-active' : ''}}" bindtap="onMemberTap">
    <view class="member-card-left">
      <image class="member-card-icon" src="/images/icons/crown.png" mode="aspectFit" />
      <view class="member-card-info">
        <text class="member-card-title" wx:if="{{isMember}}">{{memberLevelText}} · 到期 {{memberExpiry}}</text>
        <text class="member-card-title" wx:else>开通会员 · 全库 skill</text>
        <text class="member-card-desc" wx:if="{{isMember}}">全库 skill + 预览导出 + 定制调优</text>
        <text class="member-card-desc" wx:else>月费 19.9 起 · 年度 99.9 更值</text>
      </view>
    </view>
    <view class="member-card-right">
      <text class="member-card-action" wx:if="{{isMember}}">续费</text>
      <text class="member-card-action" wx:else>开通</text>
      <image class="menu-arrow-img" src="/images/icons/arrow-right.png" mode="aspectFit" />
    </view>
  </view>

  <view class="stats-row">
    <view class="stat-item">
      <text class="stat-num">{{purchasedCount}}</text>
      <text class="stat-label">已购</text>
    </view>
    <view class="stat-item">
      <text class="stat-num">{{favoriteCount}}</text>
      <text class="stat-label">收藏</text>
    </view>
    <view class="stat-item">
      <text class="stat-num">{{memberLevelText}}</text>
      <text class="stat-label">等级</text>
    </view>
  </view>

  <view class="menu-group">
    <text class="menu-group-title">账户</text>
    <view class="menu-item" bindtap="onOrdersTap">
      <image class="menu-icon-img" src="/images/icons/box.png" mode="aspectFit" />
      <text class="menu-text">我的订单</text>
      <image class="menu-arrow-img" src="/images/icons/arrow-right.png" mode="aspectFit" />
    </view>
    <view class="menu-item" bindtap="onFavoritesTap">
      <image class="menu-icon-img" src="/images/icons/heart.png" mode="aspectFit" />
      <text class="menu-text">我的收藏</text>
      <image class="menu-arrow-img" src="/images/icons/arrow-right.png" mode="aspectFit" />
    </view>
  </view>

  <view class="menu-group">
    <text class="menu-group-title">服务</text>
    <view class="menu-item" bindtap="onCommunityTap">
      <image class="menu-icon-img" src="/images/icons/chat.png" mode="aspectFit" />
      <text class="menu-text">WorkBuddy 社群</text>
      <text class="menu-badge">299/年</text>
      <image class="menu-arrow-img" src="/images/icons/arrow-right.png" mode="aspectFit" />
    </view>
    <view class="menu-item" bindtap="onPromotionTap">
      <image class="menu-icon-img" src="/images/icons/gift.png" mode="aspectFit" />
      <text class="menu-text">活动中心</text>
      <image class="menu-arrow-img" src="/images/icons/arrow-right.png" mode="aspectFit" />
    </view>
  </view>

  <view class="menu-group">
    <text class="menu-group-title">支持</text>
    <view class="menu-item" bindtap="onSupportTap">
      <image class="menu-icon-img" src="/images/icons/bell.png" mode="aspectFit" />
      <text class="menu-text">联系客服</text>
      <image class="menu-arrow-img" src="/images/icons/arrow-right.png" mode="aspectFit" />
    </view>
    <view class="menu-item" bindtap="onAboutTap">
      <image class="menu-icon-img" src="/images/icons/info.png" mode="aspectFit" />
      <text class="menu-text">关于我们</text>
      <image class="menu-arrow-img" src="/images/icons/arrow-right.png" mode="aspectFit" />
    </view>
  </view>
</view>
