
.page-container { padding-bottom: 140rpx; background: #F7F6F3; min-height: 100vh; }

.hero-card { padding: 48rpx; min-height: 300rpx; display: flex; flex-direction: column; justify-content: flex-end; }
.hero-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; }
.hero-style { font-size: 24rpx; color: rgba(255,255,255,0.8); font-weight: 600; }
.hero-tier { font-size: 22rpx; color: #fff; background: rgba(255,255,255,0.25); padding: 4rpx 16rpx; border-radius: 999rpx; font-weight: 600; }
.hero-title { font-size: 44rpx; font-weight: 800; color: #fff; line-height: 1.2; margin-bottom: 16rpx; text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.15); }
.hero-tags { display: flex; flex-wrap: wrap; gap: 12rpx; margin-bottom: 12rpx; }
.hero-tag { font-size: 24rpx; color: #fff; background: rgba(255,255,255,0.2); padding: 6rpx 20rpx; border-radius: 999rpx; }
.hero-stats { display: flex; align-items: center; gap: 16rpx; margin-top: 8rpx; }
.hero-star { font-size: 26rpx; color: #fff; font-weight: 700; }
.hero-fork { font-size: 24rpx; color: rgba(255,255,255,0.8); }
.hero-src { font-size: 22rpx; color: rgba(255,255,255,0.6); margin-left: auto; }

.skill-header { padding: 32rpx 48rpx; background: #FFFFFF; border-bottom: 2rpx solid #EAEAEA; }
.skill-desc { display: block; font-size: 30rpx; color: #5c6370; line-height: 1.5; }

.editor-review { font-size: 28rpx; color: #374151; line-height: 1.6; padding: 24rpx; background: #f0f7ff; border-radius: 16rpx; border-left: 6rpx solid #2563eb; }

.price-section { display: flex; justify-content: space-between; align-items: center; padding: 32rpx 48rpx; background: #FFFFFF; margin-top: 16rpx; border-bottom: 2rpx solid #EAEAEA; }
.price-value { font-size: 48rpx; font-weight: 800; color: #dc2626; }
.price-action { font-size: 28rpx; color: #2563eb; font-weight: 600; background: #dbeafe; padding: 12rpx 32rpx; border-radius: 999rpx; }
.section { padding: 32rpx 48rpx; background: #FFFFFF; margin-top: 16rpx; border-bottom: 2rpx solid #EAEAEA; }
.section-title { font-size: 34rpx; font-weight: 700; color: #1a1a2e; display: block; margin-bottom: 24rpx; }

.deliverable-card { padding: 24rpx; background: #f8fafc; border-radius: 16rpx; margin-bottom: 16rpx; }
.deliverable-label { font-size: 24rpx; color: #6b7280; display: block; margin-bottom: 8rpx; }
.deliverable-value { font-size: 28rpx; color: #1a1a2e; word-break: break-all; }

.skill-md-view { max-height: 800rpx; }
.skill-md-text { font-size: 24rpx; color: #374151; line-height: 1.5; }

.preview-swiper { width: 100%; height: 400rpx; border-radius: 16rpx; overflow: hidden; }
.preview-page { width: 100%; height: 100%; background: #fff; }
.preview-fallback { width: 100%; height: 400rpx; display: flex; align-items: center; justify-content: center; border-radius: 16rpx; }
.preview-fallback-text { color: #fff; font-size: 28rpx; }
.preview-counter { text-align: center; font-size: 22rpx; color: #9ca3af; padding: 8rpx 0; }

.rating-src { font-size: 22rpx; color: #9ca3af; margin-left: auto; }
.section-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; }
.section-more { font-size: 26rpx; color: #2563eb; }
.includes-grid { display: flex; }
.include-item { flex: 1; text-align: center; padding: 24rpx 0; background: #F7F6F3; border-radius: 12rpx; margin-right: 16rpx; border: 2rpx solid #EAEAEA; }
.include-item:last-child { margin-right: 0; }
.include-num { display: block; font-size: 48rpx; font-weight: 800; color: #2563eb; }
.include-label { display: block; font-size: 24rpx; color: #5c6370; margin-top: 8rpx; }
.suitable-list { display: flex; flex-wrap: wrap; }
.suitable-tag { font-size: 26rpx; color: #1a1a2e; background: #F7F6F3; padding: 12rpx 24rpx; border-radius: 999rpx; margin-right: 16rpx; margin-bottom: 16rpx; border: 2rpx solid #EAEAEA; }
.steps-list { }
.step-item { display: flex; margin-bottom: 24rpx; }
.step-num { width: 48rpx; height: 48rpx; border-radius: 50%; background: #2563eb; color: #fff; display: flex; align-items: center; justify-content: center; font-size: 28rpx; font-weight: 700; flex-shrink: 0; }
.step-content { margin-left: 20rpx; }
.step-title { display: block; font-size: 30rpx; font-weight: 600; color: #1a1a2e; }
.step-desc { display: block; font-size: 26rpx; color: #5c6370; margin-top: 4rpx; }
.agent-card { display: flex; align-items: center; padding: 24rpx 0; border-bottom: 2rpx solid #f0f2f5; position: relative; }
.agent-icon { width: 72rpx; height: 72rpx; border-radius: 16rpx; display: flex; align-items: center; justify-content: center; font-size: 32rpx; font-weight: 700; color: #fff; flex-shrink: 0; }
.agent-codex { background: #1a1a2e; }
.agent-doubao { background: #2563eb; }
.agent-wb { background: #16a34a; }
.agent-info { flex: 1; margin-left: 20rpx; }
.agent-name { display: block; font-size: 30rpx; font-weight: 600; color: #1a1a2e; }
.agent-desc { display: block; font-size: 24rpx; color: #5c6370; margin-top: 4rpx; }
.agent-badge { position: absolute; right: 120rpx; top: 24rpx; font-size: 20rpx; color: #fff; background: #16a34a; padding: 4rpx 12rpx; border-radius: 999rpx; font-weight: 700; }
.copy-btn { background: #2563eb; color: #fff; padding: 12rpx 28rpx; border-radius: 999rpx; font-size: 26rpx; font-weight: 600; }
.rating-row { display: flex; align-items: center; margin-bottom: 24rpx; }
.rating-num { font-size: 48rpx; font-weight: 800; color: #1a1a2e; margin-right: 16rpx; }
.rating-stars { font-size: 28rpx; color: #f59e0b; margin-right: 16rpx; }
.rating-count { font-size: 24rpx; color: #5c6370; }
.review-item { padding: 24rpx 0; border-top: 2rpx solid #f0f2f5; }
.review-header { display: flex; justify-content: space-between; margin-bottom: 8rpx; }
.review-user { font-size: 28rpx; font-weight: 600; color: #1a1a2e; }
.review-stars { font-size: 24rpx; color: #f59e0b; }
.review-text { display: block; font-size: 28rpx; color: #1a1a2e; line-height: 1.5; }
.review-date { display: block; font-size: 22rpx; color: #9ca3af; margin-top: 8rpx; }
.empty-reviews { text-align: center; padding: 32rpx 0; color: #9ca3af; font-size: 26rpx; }
.related-list { display: flex; flex-wrap: wrap; }
.related-card { width: 48%; margin-right: 4%; margin-bottom: 16rpx; background: #F7F6F3; border: 2rpx solid #EAEAEA; border-radius: 12rpx; overflow: hidden; }
.related-card:nth-child(2n) { margin-right: 0; }
.related-header { height: 80rpx; display: flex; align-items: center; padding: 0 20rpx; }
.related-style { color: #fff; font-size: 24rpx; font-weight: 600; }
.related-body { padding: 16rpx 20rpx; background: #FFFFFF; }
.related-name { display: block; font-size: 26rpx; font-weight: 600; color: #1a1a2e; line-height: 1.3; }
.related-price { display: block; font-size: 28rpx; font-weight: 700; color: #dc2626; margin-top: 8rpx; }
.bottom-bar { position: fixed; bottom: 0; left: 0; right: 0; display: flex; align-items: center; padding: 16rpx 48rpx; background: #FFFFFF; border-top: 2rpx solid #EAEAEA; box-shadow: 0 -4rpx 12rpx rgba(0,0,0,0.06); }
.bottom-icon-btn { padding: 12rpx 20rpx; margin-right: 16rpx; }
.bottom-icon { font-size: 26rpx; color: #5c6370; }
.bottom-icon.favorited { color: #dc2626; font-weight: 600; }
.buy-btn { flex: 1; height: 88rpx; display: flex; align-items: center; justify-content: center; background: #2563eb; border-radius: 999rpx; font-size: 32rpx; font-weight: 700; color: #fff; }
.buy-btn.purchased { background: #16a34a; }

.purchased-info { text-align: center; font-size: 24rpx; color: #16a34a; padding: 16rpx 0; }
.buy-btn.purchased { background: #16a34a; }

.review-avatar { width: 64rpx; height: 64rpx; border-radius: 50%; margin-right: 16rpx; flex-shrink: 0; background: #f0f2f5; }
.review-body { flex: 1; }
