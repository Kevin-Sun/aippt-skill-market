/* detail.wxss · 清新 UI + 高对比度 */

.page-container {
  padding-bottom: 140rpx;
  background: #f0f2f5;
  min-height: 100vh;
}

/* skill 信息 */
.skill-header {
  padding: 40rpx 32rpx;
  background: #ffffff;
  border-bottom: 2rpx solid #e5e7eb;
}
.skill-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #1a1a2e;
  line-height: 1.3;
  margin-bottom: 16rpx;
}
.skill-desc {
  display: block;
  font-size: 30rpx;
  color: #5c6370;
  line-height: 1.5;
  margin-bottom: 24rpx;
}
.skill-tags {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
}
.skill-tags > text + text {
  margin-left: 12rpx;
}
.tag-scene {
  font-size: 24rpx;
  color: #2563eb;
  background: #dbeafe;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-weight: 600;
}
.tag-style {
  font-size: 24rpx;
  color: #7c3aed;
  background: #ede9fe;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}
.tag-lang {
  font-size: 24rpx;
  color: #5c6370;
  background: #f0f2f5;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}
.tag-recommend {
  font-size: 24rpx;
  color: #ffffff;
  background: #16a34a;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-weight: 700;
}

/* 价格区 */
.price-section {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  background: #ffffff;
  margin-top: 16rpx;
  border-bottom: 2rpx solid #e5e7eb;
}
.price-label {
  font-size: 30rpx;
  color: #5c6370;
  font-weight: 600;
}
.price-value {
  font-size: 48rpx;
  font-weight: 800;
  color: #dc2626;
}

/* 获取方式 */
.agents-section {
  padding: 32rpx;
  background: #ffffff;
  margin-top: 16rpx;
}
.section-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #1a1a2e;
  margin-bottom: 24rpx;
}
.agent-card {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 2rpx solid #f0f2f5;
}
.agent-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 700;
  color: #ffffff;
  flex-shrink: 0;
}
.agent-icon-codex { background: #1a1a2e; }
.agent-icon-doubao { background: #2563eb; }
.agent-icon-wb { background: #16a34a; }

.agent-info {
  flex: 1;
  margin-left: 24rpx;
  position: relative;
}
.agent-name {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a2e;
}
.agent-desc {
  display: block;
  font-size: 26rpx;
  color: #5c6370;
  margin-top: 8rpx;
}
.agent-badge {
  position: absolute;
  top: 0;
  right: 0;
  font-size: 22rpx;
  color: #ffffff;
  background: #16a34a;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-weight: 700;
}
.agent-copy-btn {
  background: #2563eb;
  color: #ffffff;
  padding: 16rpx 32rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  font-weight: 600;
  flex-shrink: 0;
}

/* 底部操作 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 32rpx;
  background: #ffffff;
  border-top: 2rpx solid #e5e7eb;
  box-shadow: 0 -4rpx 12rpx rgba(0,0,0,0.06);
}
.buy-btn {
  width: 100%;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #2563eb;
  border-radius: 12rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #ffffff;
  border: none;
}
.buy-btn.purchased {
  background: #16a34a;
}
