.chat-container { display: flex; flex-direction: column; height: 100vh; background: #f9fafb; }

.chat-header { display: flex; justify-content: space-between; align-items: center; padding: 24rpx 32rpx; background: #fff; border-bottom: 1rpx solid #e5e7eb; }
.chat-title { font-size: 32rpx; font-weight: 600; color: #1a1a2e; }
.chat-usage { font-size: 24rpx; color: #6b7280; background: #f3f4f6; padding: 6rpx 16rpx; border-radius: 999rpx; }

.message-list { flex: 1; padding: 24rpx 32rpx; overflow-y: auto; }

.message-item { margin-bottom: 24rpx; display: flex; }
.message-item.user { justify-content: flex-end; }
.message-item.assistant { justify-content: flex-start; }
.message-item.system { justify-content: center; }
.message-text { max-width: 70%; padding: 20rpx 28rpx; border-radius: 20rpx; font-size: 28rpx; line-height: 1.5; }
.message-item.user .message-text { background: #2563eb; color: #fff; border-bottom-right-radius: 4rpx; }
.message-item.assistant .message-text { background: #fff; color: #1a1a2e; border-bottom-left-radius: 4rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06); }
.message-item.system .message-text { background: transparent; color: #9ca3af; font-size: 24rpx; }

.download-section { padding: 24rpx 32rpx; }
.download-btn { height: 80rpx; display: flex; align-items: center; justify-content: center; background: #16a34a; border-radius: 12rpx; }
.download-btn text { color: #fff; font-size: 28rpx; font-weight: 600; }

.chat-loading { text-align: center; padding: 16rpx; }
.chat-loading text { font-size: 26rpx; color: #6b7280; }

.chat-input-bar { display: flex; gap: 16rpx; padding: 20rpx 32rpx; background: #fff; border-top: 1rpx solid #e5e7eb; }
.chat-input { flex: 1; height: 72rpx; background: #f3f4f6; border-radius: 999rpx; padding: 0 28rpx; font-size: 28rpx; }
.send-btn { width: 120rpx; height: 72rpx; display: flex; align-items: center; justify-content: center; background: #2563eb; border-radius: 999rpx; }
.send-btn.disabled { opacity: 0.5; }
.send-btn text { color: #fff; font-size: 28rpx; font-weight: 600; }
