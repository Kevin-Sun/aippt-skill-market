<!--pages/chat/chat.wxml -->
<view class="chat-container">
  <view class="chat-header">
    <text class="chat-title">{{skillName}}</text>
    <text class="chat-usage" wx:if="{{usageLimit > 0}}">剩余 {{usageLimit - usageUsed}}/{{usageLimit}} 次</text>
    <text class="chat-usage" wx:else>需会员</text>
  </view>

  <scroll-view class="message-list" scroll-y scroll-into-view="msg-bottom">
    <view class="message-item {{item.role}}" wx:for="{{messages}}" wx:key="index">
      <text class="message-text">{{item.text}}</text>
    </view>
    <view id="msg-bottom"></view>
  </scroll-view>

  <view class="download-section" wx:if="{{pptxFileID}}">
    <view class="download-btn" bindtap="onDownload">
      <text>查看 .pptx 文件</text>
    </view>
  </view>

  <view class="chat-loading" wx:if="{{isGenerating}}">
    <text>AI 生成中...</text>
  </view>

  <view class="chat-input-bar">
    <input class="chat-input" placeholder="说点什么，比如「做一份工作汇报」" value="{{inputText}}" bindinput="onInput" bindconfirm="onSend" />
    <view class="send-btn {{isGenerating ? 'disabled' : ''}}" bindtap="onSend">
      <text>发送</text>
    </view>
  </view>
</view>
